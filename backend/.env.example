# ---------------------------------------------------------------------------
# Yawnfox backend environment variables
# Copy to `.env` for local development; on Fly.io set these with `fly secrets set`.
# ---------------------------------------------------------------------------

# --- Redis (Upstash) -------------------------------------------------------
# The backend uses redis-py over a TLS connection (rediss://) because cross-
# instance signaling relies on Redis pub/sub.
#
# Easiest: paste the full connection URL from the Upstash console
#   (database -> "Connect" -> redis-py / "rediss://" tab). It already contains
#   the password:
UPSTASH_REDIS_URL=rediss://default:YOUR_PASSWORD@your-db.upstash.io:6379

# Alternatively, put just the host in UPSTASH_REDIS_URL (e.g. your-db.upstash.io)
# and the database password here; the backend assembles a rediss:// URL on
# port 6379. Leave blank if UPSTASH_REDIS_URL already includes credentials.
UPSTASH_REDIS_TOKEN=

# Local development without Upstash (used ONLY if UPSTASH_REDIS_URL is empty):
# REDIS_URL=redis://localhost:6379

# --- CORS / security -------------------------------------------------------
# Comma-separated list of allowed browser origins for the signaling WebSocket
# and the /ping endpoint. Leave empty to allow all origins (development only).
CORS_ORIGIN=https://yawnfox.com

# --- Rate limiting (optional overrides) ------------------------------------
# Max new WebSocket connections per IP within the sliding window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# Trust the X-Forwarded-For header when deriving the client IP. Keep "false"
# unless the app sits behind a proxy you control that sets it; otherwise it can
# be spoofed to evade the rate limiter. On Fly, fly-client-ip is used regardless.
TRUST_XFF=false

# --- TTL / tuning (optional overrides, seconds) ----------------------------
# CONN_TTL=90
# PARTNER_TTL=300
# TOPICS_TTL=1800

# --- Server ----------------------------------------------------------------
PORT=8080
