# ---------------------------------------------------------------------------
# Yawnfox backend environment variables
#
# LOCAL DEVELOPMENT
#   Copy this file to `.env` (gitignored). main.py calls load_dotenv() before
#   any other import, so `.env` is picked up automatically — no --env-file flag
#   and no exporting by hand. load_dotenv() does not override variables already
#   present in the real environment, so an exported shell value still wins.
#
#   Two settings are best left unset locally, and the sample `.env` keeps them
#   commented out for that reason:
#     - REDIS_URL   : empty selects in-memory mode, so no Redis is needed
#     - CORS_ORIGIN : empty allows all origins, so http://localhost can connect
#
# FLY.IO
#   Set these with `fly secrets set KEY=value`. dotenv has no effect there:
#   `.env` is gitignored and excluded via .dockerignore, so no such file exists
#   in the image and load_dotenv() is a harmless no-op.
# ---------------------------------------------------------------------------

# --- Redis -----------------------------------------------------------------
# The backend uses redis-py over a TLS connection (rediss://) because cross-
# instance signaling relies on Redis pub/sub.
#
# REDIS_URL is the single switch for how the backend stores shared state:
#   empty / unset -> in-memory mode. No Redis is contacted, state lives in this
#                    process. Single-instance only; the right choice for local
#                    development and the default in this template.
#   set           -> Redis mode, required for running more than one instance.
#
# Accepted forms:
#   1. A full URL, pasted from the Upstash console
#      (database -> "Connect" -> redis-py / "rediss://" tab); it already
#      contains the password:
#        REDIS_URL=rediss://default:YOUR_PASSWORD@your-db.upstash.io:6379
#   2. A local Redis for multi-instance testing:
#        REDIS_URL=redis://localhost:6379
#   3. A bare host, with the password supplied separately in
#      UPSTASH_REDIS_TOKEN; the backend assembles a rediss:// URL on port 6379:
#        REDIS_URL=your-db.upstash.io
#
# WARNING: pointing this at your production Upstash database from a local run
# makes local clients share the live matchmaking pool — the Redis key prefix
# ("yf:") is the same in every environment. Leave it unset for local work.
# REDIS_URL=

# Password used ONLY when REDIS_URL is a bare host (form 3 above).
# Leave blank when REDIS_URL already includes credentials.
UPSTASH_REDIS_TOKEN=

# --- CORS / security -------------------------------------------------------
# Comma-separated list of allowed browser origins for the signaling WebSocket
# and the /ping endpoint. Leave empty to allow all origins (development only).
CORS_ORIGIN=https://yawnfox.com

# --- Rate limiting (optional overrides) ------------------------------------
# Max new WebSocket connections per IP within the sliding window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# Per-socket message budget, applied to every frame after the connection is up
# (a token bucket held in the process; no Redis involved). MSG_BURST is the
# allowance a client can spend at once -- a full ICE exchange fits comfortably --
# and MSG_RATE is the sustained refill. PAIRING_START is charged 5 tokens because
# it costs about that many Redis commands downstream.
# MSG_RATE=20
# MSG_BURST=40

# Trust the X-Forwarded-For header when deriving the client IP. Keep "false"
# unless the app sits behind a proxy you control that sets it; otherwise it can
# be spoofed to evade the rate limiter. On Fly, fly-client-ip is used regardless.
TRUST_XFF=false

# --- TTL / tuning (optional overrides, seconds) ----------------------------
# CONN_TTL=90
# PARTNER_TTL=300
# TOPICS_TTL=1800

# --- Server ----------------------------------------------------------------
PORT=8080
