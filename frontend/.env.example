# ---------------------------------------------------------------------------
# Yawnfox frontend environment variables
#
# Copy this file to `.env` (gitignored). Vite only exposes variables prefixed
# with VITE_ to browser code, so this is the complete list.
# ---------------------------------------------------------------------------

# Host[:port] of the signaling backend — NO scheme. peer.js picks ws:// or
# wss:// to match the page it is served from (see createSdpExchange).
#
#   local backend:  VITE_API_DOMAIN=localhost:8080
#   production:     VITE_API_DOMAIN=api.yawnfox.com
VITE_API_DOMAIN=api.yawnfox.com
